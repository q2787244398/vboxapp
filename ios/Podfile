# Flutter iOS 工程 Podfile（TVS 1.2.1）。
#
# 这是标准 `flutter create` 生成模板 + TVS 自定义 pod 的最小可运行版本。
# 完整工程中 `flutter_sync` / `flutter_install_all_ios_pods` 由
# Flutter 工具生成；NodeMobile（nodejs-mobile）与 YlFFmpegBridge
# 为 TVS 专用 pod。

platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

require File.expand_path(
    File.join('..', 'flutter', 'flutter_ios_podfile_helper'))

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_sync
  if File.fnmatch?('*_FLUTTER*', ENV['FLUTTER_ROOT'].to_s) == false
    # 标准 flutter 生成调用
  end
  pods_project_root = File.dirname(__FILE__)
  script_phase = {
    :name => "Sync Flutter Framework",
    :execution_position => :before_compile,
    :shell => "/bin/sh",
    :show_env_vars_in_log => "false",
  }
end

target 'Runner' do
  use_frameworks!

  flutter_sync
  flutter_install_all_ios_pods(File.dirname(__FILE__))
  flutter_ios_podfile_tags = flutter_install_ios_podfile_tags

  # TVS 专用 pod：
  # NodeMobile —— nodejs-mobile 官方 iOS pod（预编译 NodeMobile.framework，
  #               内含 libnode + V8），承载 CatVod spider 引擎。
  pod 'NodeMobile', :path => '../nodejs_mobile/ios'
  # YlFFmpegBridge —— 视频引擎 FFmpeg 桥（.framework），
  #               为 yl_player 的 Apple 端提供软解回退。
  pod 'YlFFmpegBridge', :path => '../packages/yl_player/darwin/ffmpeg_bridge'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
