<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVS" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/tvs_accent</item>
        <item name="android:statusBarColor">@color/tvs_primary_dark</item>
        <item name="android:navigationBarColor">@color/tvs_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="Theme.TVS.ConfigCenter" parent="Theme.TVS">
        <item name="android:windowBackground">@color/tvs_background</item>
    </style>
</resources>
